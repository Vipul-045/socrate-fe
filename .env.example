# socrate.in. Production values go in .env (or the host's environment
# variables: on Vercel, Settings → Environment Variables); local overrides go
# in .env.development.local, which `next dev` reads first. Both are git-ignored.
# NEXT_PUBLIC_ values and SOCRATE_APP_URL are fixed into the bundle at build
# time, so a change needs a new build (a redeploy on Vercel).

# The Socrate app. Every way into it uses this: "Go to app" and a signed-in
# reader's "Get started free", and "Go to Socrate" after checkout or email
# verification. Required: next.config.ts won't start without it, or build
# for production with a localhost one. It has no NEXT_PUBLIC_ prefix, but
# next.config.ts's `env` puts it into browser code too — on Vercel, set it
# for Production and Preview.
#   production:             https://app.socrate.in
#   .env.development.local: http://localhost:4100
SOCRATE_APP_URL=https://app.socrate.in

# The backend (sign-in, plans, checkout). Not the app.
#   production:             https://api.socrate.in
#   .env.development.local: http://localhost:3000
NEXT_PUBLIC_BACKENDBASEURL=https://api.socrate.in
